<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Base Info.plist for the iOS target.

  Deliberately tiny. `GENERATE_INFOPLIST_FILE` stays on and merges every `INFOPLIST_KEY_*`
  build setting in `project.yml` on top of this file at build time, so purpose strings and
  scene configuration keep living in the manifest where they are reviewable next to the
  entitlements. Only values that cannot be expressed safely as scalar `INFOPLIST_KEY_*`
  build settings live here: app-defined arrays and the launch-screen dictionary.

  This file is hand-written and tracked, unlike Barosense.xcodeproj. XcodeGen references it
  through INFOPLIST_FILE and does not generate it.
-->
<plist version="1.0">
<dict>
	<!-- Barometer sampling wakes. Must match PressureSamplingPolicy.backgroundRefreshIdentifier;
	     a submission for an identifier missing here throws BGTaskSchedulerErrorCodeNotPermitted
	     and the refresh chain silently never starts. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.barosense.pressure.refresh</string>
	</array>
	<!-- `fetch` is what BGAppRefreshTask runs under. No `processing`: the work is one sensor
	     read and one row, not a long batch. No `location`, no `audio` — nothing here is
	     allowed to keep the app resident. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<!-- Coarse location only. The prompt then offers "Precise: Off" as the default and the
	     user is never asked to hand over a precise fix. Nothing in this app consumes one:
	     LocationEpochResolver rounds every coordinate to 0.1° (~11 km) before it is stored,
	     and WeatherKit's grid is coarser than that again.

	     Written here as a real Boolean rather than left to INFOPLIST_KEY_* injection alone.
	     How that mechanism types a key it does not recognise is not documented, and a
	     <string>YES</string> would be ignored by CoreLocation — the app would then ask for
	     precise location while every comment in the codebase claimed it did not. project.yml
	     carries the setting too, and the merged plist has been checked to contain a real
	     <true/>. -->
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<!-- iOS owns the first frame of a cold launch and permits no animation there. Matching
	     its fill to LaunchLoadingView avoids a light flash before SwiftUI starts the GIF. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
